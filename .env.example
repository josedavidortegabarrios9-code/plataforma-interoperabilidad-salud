# ==============================================================================
# Archivo de Variables de Entorno — Plataforma de Interoperabilidad Clínica
# ==============================================================================
# INSTRUCCIONES DE SEGURIDAD:
#   1. Copie este archivo en la raíz del proyecto para crear su configuración local:
#      cp .env.example .env
#   2. Defina sus secretos y contraseñas seguras a continuación.
#   3. El archivo .env está protegido por .gitignore y NUNCA se sube a Git.
# ==============================================================================

# --- Seguridad Criptográfica JWT (Fase 4 - RBAC) ---
# Clave privada para firmar y verificar tokens HMAC-SHA256.
JWT_SECRET=super_secret_clinical_interoperability_key_2026

# --- Contraseñas de Usuarios Clínicos (Se cargan y hashean con SHA-256 en memoria) ---
MEDICO_PASSWORD=medico123
ADMISION_PASSWORD=admision123
AUDITOR_PASSWORD=auditor123
PACIENTE_PASSWORD=paciente123

# --- Bases de Datos PostgreSQL de Sedes Distribuidas (RF4) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

SEDE1_PORT=5431
SEDE2_PORT=5432
SEDE3_PORT=5433

# --- Servidor HAPI FHIR R4 ---
HAPI_FHIR_URL=http://localhost:8090/fhir

# --- Configuración del Servicio HSB ---
HSB_HOST=0.0.0.0
HSB_PORT=8000
