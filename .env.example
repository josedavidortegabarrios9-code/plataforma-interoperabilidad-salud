# ============================================================
# Archivo de Variables de Entorno — Plataforma de Interoperabilidad Clínica
# ============================================================
# INSTRUCCIONES:
#   1. Copie este archivo: cp .env.example .env
#   2. Reemplace los valores de ejemplo con credenciales reales
#   3. NUNCA suba el archivo .env al repositorio (ya está en .gitignore)
# ============================================================

# --- Seguridad JWT ---
# Clave secreta para firmar y verificar tokens JWT (HMAC-SHA256).
# Use una cadena aleatoria de al menos 32 caracteres.
JWT_SECRET=cambie_esto_por_una_clave_secreta_robusta_minimo_32_caracteres

# --- Bases de Datos PostgreSQL (Sedes) ---
# Las tres sedes IPS se conectan a instancias separadas de PostgreSQL.
DB_SEDE1_HOST=localhost
DB_SEDE1_PORT=5431
DB_SEDE1_NAME=sede1_db
DB_SEDE1_USER=postgres
DB_SEDE1_PASSWORD=cambie_esto

DB_SEDE2_HOST=localhost
DB_SEDE2_PORT=5432
DB_SEDE2_NAME=sede2_db
DB_SEDE2_USER=postgres
DB_SEDE2_PASSWORD=cambie_esto

DB_SEDE3_HOST=localhost
DB_SEDE3_PORT=5433
DB_SEDE3_NAME=sede3_db
DB_SEDE3_USER=postgres
DB_SEDE3_PASSWORD=cambie_esto

# --- Servidor HAPI FHIR ---
FHIR_SERVER_URL=http://localhost:8090/fhir

# --- Configuración del Servicio HSB ---
HSB_HOST=0.0.0.0
HSB_PORT=8000
HSB_DEBUG=false
